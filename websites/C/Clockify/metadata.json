{
  "$schema": "https://schemas.premid.app/metadata/1.16",
  "apiVersion": 1,
  "author": {
    "id": "905070469751926825",
    "name": "guilhermehfr"
  },
  "service": "Clockify",
  "description": {
    "en": "Track time and manage projects with Clockify.",
    "pt-br": "Rastreie tempo e gerencie projetos com o Clockify."
  },
  "url": "clockify.me",
  "regExp": "^https?[:][/][/]([a-z0-9-]+[.])*clockify[.]me[/]",
  "version": "1.1.0",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/C/Clockify/assets/logo.png",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/C/Clockify/assets/thumbnail.png",
  "color": "#03A9F4",
  "category": "other",
  "tags": [
    "time-tracking",
    "productivity",
    "work",
    "projects",
    "tracker"
  ],
  "settings": [
    {
      "id": "showProject",
      "title": "Show project name",
      "icon": "fas fa-folder",
      "value": true
    },
    {
      "id": "showProjectTime",
      "title": "Show project time today",
      "icon": "fas fa-stopwatch",
      "value": true
    },
    {
      "id": "showDaily",
      "title": "Show daily total",
      "icon": "fas fa-calendar-day",
      "value": true
    },
    {
      "id": "showWeekly",
      "title": "Show weekly total",
      "icon": "fas fa-calendar-week",
      "value": true
    }
  ]
}
