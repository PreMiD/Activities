{
  "$schema": "https://schemas.premid.app/metadata/1.17",
  "apiVersion": 1,
  "author": {
    "id": "754572586914021468",
    "name": "0120r"
  },
  "service": "KonomiTV",
  "description": {
    "en": "KonomiTV is a self-hosted media server for watching Japanese digital TV broadcasts and recorded programs in the browser.",
    "ja": "KonomiTV は、ブラウザでテレビのライブ視聴と録画番組の再生ができる、自宅サーバー型のメディアサーバーです。"
  },
  "url": "my.local.konomi.tv",
  "regExp": "^https?[:][/][/]([a-z0-9-]+[.])*local[.]konomi[.]tv([:][0-9]+)?[/]",
  "version": "1.0.1",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/K/KonomiTV/assets/logo.png",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/K/KonomiTV/assets/thumbnail.png",
  "color": "#E64F97",
  "category": "videos",
  "tags": [
    "tv",
    "live",
    "japan",
    "dtv",
    "recording",
    "edcb",
    "mirakurun"
  ],
  "settings": [
    {
      "id": "showProgram",
      "title": "番組名を表示",
      "icon": "fad fa-tv",
      "value": true
    },
    {
      "id": "timestamp",
      "title": "経過・残り時間を表示",
      "icon": "fad fa-stopwatch",
      "value": true
    },
    {
      "id": "browsing",
      "title": "視聴していないページも表示",
      "icon": "fad fa-compass",
      "value": true
    }
  ]
}
