{
  "$schema": "https://schemas.premid.app/metadata/1.16",
  "apiVersion": 1,
  "author": {
    "id": "339316517558681610",
    "name": "firstoften"
  },
  "contributors": [
    {
      "name": "SkyJoshua",
      "id": "633705563267661824"
    }
  ],
  "service": "MovieBoxPro",
  "description": {
    "en": "MovieBoxPro is for watching movies and TV shows, offering details like posters, cast info, trailers, and trending titles, sourced from The Movie Database"
  },
  "url": "movieboxpro.app",
  "regExp": "^https?[:][/][/]([a-z0-9-]+[.])*movieboxpro[.]app[/]",
  "version": "1.4.0",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/M/MovieBoxPro/assets/logo.jpg",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/M/MovieBoxPro/assets/thumbnail.png",
  "color": "#fcba03",
  "category": "videos",
  "tags": [
    "movies",
    "series",
    "watch"
  ],
  "settings": [
    {
      "id": "showBrowsingStatus",
      "value": true,
      "title": "Show Browsing Status",
      "icon": "fas fa-compass"
    },
    {
      "id": "showLookingAtStatus",
      "value": true,
      "title": "Show \"Looking at a Movie/Show\" Status",
      "icon": "fas fa-eye"
    },
    {
      "id": "movieHeaderFormat",
      "value": 1,
      "values": [
        "MovieBoxPro",
        "MovieName"
      ],
      "title": "Movies: \"Watching\" Line",
      "icon": "fas fa-film"
    },
    {
      "id": "showHeaderFormat",
      "value": 1,
      "values": [
        "MovieBoxPro",
        "ShowName",
        "ShowName Season/Episode"
      ],
      "title": "Shows: \"Watching\" Line",
      "icon": "fas fa-tv"
    },
    {
      "id": "episodeFormat",
      "value": 0,
      "values": [
        "S## E##",
        "##x##"
      ],
      "title": "Episode Format",
      "icon": "fas fa-hashtag"
    },
    {
      "id": "hideWhenPaused",
      "value": false,
      "title": "Hide when Paused",
      "icon": "fas fa-eye-slash"
    },
    {
      "id": "showImdbButton",
      "value": true,
      "title": "Show IMDb Button",
      "icon": "fas fa-star"
    },
    {
      "id": "showEpisodeButton",
      "value": true,
      "title": "Show Episode Button",
      "icon": "fas fa-star-half-alt"
    }
  ]
}
