      "title": "Show Buttons",
      "icon": "fas fa-compress-arrows-alt",
      "value": true
    },
    {
      "id": "cover",
      "if": {
        "privacy": false
      },
      "title": "Show Cover",
      "icon": "fad fa-images",
      "value": true
    },
    {
      "id": "tab",
      "if": {
        "privacy": false
      },
      "title": "Show Tab",
      "icon": "fas fa-columns",
      "value": true
    }
  ]
