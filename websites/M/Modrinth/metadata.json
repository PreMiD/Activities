  "tags": [
    "minecraft",
    "mods",
    "modpacks",
    "plugins",
    "forge",
    "fabric",
    "quilt",
    "spigot"
  ],
  "settings": [
    {
      "id": "lang",
      "multiLanguage": true
    },
    {
      "id": "privacy",
      "title": "Privacy Mode",
      "icon": "fad fa-user-secret",
      "value": false
    },
    {
      "id": "buttons",
      "if": {
        "privacy": false
