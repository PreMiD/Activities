  ],
  "description": {
    "en": "MC Championship is a Minecraft mini-game tournament, and MCC Island is a free-to-play multiplayer server for Minecraft: Java Edition. The associated websites feature event news, community forums, and event leaderboards. The unofficial, community-run MCC Island Wiki provides information about MCC Island. Lighthouse, MCCI Hub, and MCC Island Stats provide MCC Island player statistics. ReafyStats provides MC Championship player and event statistics, while Radar maps fishing spots on MCC Island."
  },
  "url": [
    "mcchampionship.com",
    "mccisland.net",
    "mcc.live",
    "mccisland.wiki",
    "stats.sirarchibald.dev",
    "lighthouse.gay",
    "mccihub.net",
    "stats.derniklaas.de",
    "radar.themysterys.com",
    "reafystats.com"
  ],
  "regExp": "^https?[:][/][/]([a-z0-9-]+[.])*(mcchampionship[.]com|mccisland[.]net|mcc[.]live|mccisland[.]wiki|stats[.]sirarchibald[.]dev|lighthouse[.]gay|mccihub[.]net|stats[.]derniklaas[.]de|radar[.]themysterys[.]com|reafystats[.]com)[/]",
  "version": "1.0.3",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/M/MCC%20%2B%20Island/assets/logo.png",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/M/MCC%20%2B%20Island/assets/thumbnail.png",
  "color": "#F0443E",
  "category": "games",
