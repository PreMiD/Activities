{
  "$schema": "https://schemas.premid.app/metadata/1.17",
  "apiVersion": 1,
  "author": {
    "name": "heiwafr",
    "id": "1086606341990256650"
  },
  "service": "HeiwaStream",
  "description": {
    "en": "Browse movies, series and anime available on HeiwaStream.",
    "fr": "Parcourez les films, séries et animés disponibles sur HeiwaStream."
  },
  "url": "heiwastream.fr",
  "regExp": "^https?[:][/][/](?:www[.])?heiwastream[.]fr(?:[/]|$)",
  "version": "1.1.0",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/H/HeiwaStream/assets/logo.png",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/H/HeiwaStream/assets/thumbnail.png",
  "color": "#e6a91a",
  "category": "videos",
  "tags": [
    "movies",
    "series",
    "anime"
  ],
  "settings": [
    {
      "id": "lang",
      "multiLanguage": true
    },
    {
      "id": "privacy",
      "title": "Privacy Mode",
      "icon": "fad fa-user-secret",
      "value": false
    },
    {
      "id": "showBrowsing",
      "title": "Show Browsing Status",
      "icon": "fad fa-book-reader",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "usePresenceName",
      "title": "Show Title as Presence",
      "icon": "fad fa-user-edit",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "showCover",
      "title": "Show Cover",
      "icon": "fas fa-images",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "showSynopsis",
      "title": "Show Synopsis",
      "icon": "fad fa-align-left",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "showWatchParty",
      "title": "Show Watch Party",
      "icon": "fad fa-users",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "showTimestamp",
      "title": "Show Timestamps",
      "icon": "fad fa-stopwatch",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "showButtons",
      "title": "Show Buttons",
      "icon": "fad fa-compass",
      "value": true,
      "if": {
        "privacy": false
      }
    }
  ]
}
