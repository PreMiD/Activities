  "tags": [
    "radio",
    "simulation",
    "gaming",
    "ets2",
    "ats",
    "haulmp"
  ],
  "settings": [
    {
      "id": "privacy",
      "title": "Privacy Mode",
      "icon": "fas fa-user-secret",
      "value": false
    },
    {
      "id": "cover",
      "title": "Show Cover Art",
      "icon": "fas fa-images",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "presenter",
      "title": "Show Live Presenter",
      "icon": "fas fa-microphone",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "buttons",
      "title": "Show Buttons",
      "icon": "fas fa-compress-arrows-alt",
      "value": true,
      "if": {
        "privacy": false
      }
    }
