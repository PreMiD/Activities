  },
  "url": "fs01.lol",
  "regExp": "^https?://(?:www\\.)?fs[0-9]+\\.lol(?:/|$)",
  "version": "1.0.0",
  "logo": "https://i.imgur.com/7eKVAQo.png",
  "thumbnail": "https://i.imgur.com/WgFcORr.png",
  "color": "#F48625",
  "category": "videos",
  "tags": [
    "french",
    "films",
    "series",
    "streaming"
  ],
  "iframe": true,
  "iFrameRegExp": "^https?://",
  "settings": [
    {
      "id": "lang",
