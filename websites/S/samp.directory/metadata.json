  "color": "#A78BFA",
  "category": "games",
  "tags": [
    "samp",
    "sa-mp",
    "gta",
    "san-andreas",
    "multiplayer",
    "browser-game"
  ],
  "settings": [
    {
      "id": "privacy",
      "title": "Privacy Mode",
      "icon": "fa-solid fa-user-secret",
      "value": false
    },
    {
      "id": "job",
      "title": "Show Job",
      "icon": "fa-solid fa-briefcase",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "area",
      "title": "Show Area",
      "icon": "fa-solid fa-location-dot",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "vehicle",
      "title": "Show Vehicle",
      "icon": "fa-solid fa-car",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "wanted",
      "title": "Show Wanted Level",
      "icon": "fa-solid fa-star",
      "value": true,
      "if": {
        "privacy": false
      }
    },
    {
      "id": "timestamp",
      "title": "Show Timestamp",
      "icon": "fa-solid fa-clock",
      "value": true
    }
  ]
