{
  "$schema": "https://schemas.premid.app/metadata/1.16",
  "apiVersion": 1,
  "author": {
    "name": "Bas950",
    "id": "241278257335500811"
  },
  "contributors": [
    {
      "name": "hashking710",
      "id": "608311692644057088"
    }
  ],
  "service": "Bandcamp",
  "description": {
    "en": "Discover amazing music and directly support the artists who make it.",
    "nl": "Ontdek geweldige muziek en ondersteun direct de artiesten die het maken.",
    "vi": "Khám phá những bản nhạc tuyệt vời và ủng hộ trực tiếp các nghệ sĩ đã làm ra nó."
  },
  "url": "bandcamp.com",
  "regExp": "^https?[:][/][/]([a-z0-9-]+[.])*bandcamp([.][a-z]+)+[/]",
  "version": "1.5.0",
  "logo": "https://cdn.rcd.gg/PreMiD/websites/B/Bandcamp/assets/logo.png",
  "thumbnail": "https://cdn.rcd.gg/PreMiD/websites/B/Bandcamp/assets/thumbnail.png",
  "color": "#61929c",
  "category": "music",
  "tags": [
    "music",
    "albums"
  ],
  "settings": [
    {
      "id": "lang",
      "multiLanguage": true
    },
    {
      "id": "timestamp",
      "title": "Show Timestamps",
      "icon": "fas fa-clock",
      "value": true
    },
    {
      "id": "cover",
      "title": "Show Cover",
      "icon": "fad fa-images",
      "value": true
    },
    {
      "id": "links",
      "title": "Link to Track/Artist",
      "icon": "fas fa-arrow-up-right-from-square",
      "value": true
    },
    {
      "id": "displayType",
      "title": "Pick Status Display",
      "icon": "fad fa-user-edit",
      "value": 1,
      "values": [
        "Activity Name",
        "Artist Name",
        "Track Title"
      ]
    }
  ]
}
